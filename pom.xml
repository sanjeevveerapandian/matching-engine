<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sanjeev</groupId>
    <artifactId>matching-engine</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Keep parameter names in the class files, so Spring can bind @PathVariable and records by name. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <spring-boot.version>3.5.16</spring-boot.version>
    </properties>

    <!--
      Spring Boot's "bill of materials": it only says WHICH VERSION of each library to use (Jackson,
      JUnit, Mockito, Tomcat, ...), so they all fit together. We import it instead of inheriting
      spring-boot-starter-parent, so this pom keeps its own plugin versions and structure.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Used by com.sanjeev.infra (the command log). The engine package never imports it.
             No version here: Spring Boot's bill of materials picks the one Spring itself uses. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Used ONLY by com.sanjeev.api (the REST layer). Neither engine nor infra imports Spring. -->
        <dependency>
            <!-- Spring MVC + embedded Tomcat + Jackson JSON -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <!-- Bean Validation (@NotBlank, @Positive, ...) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <!-- JUnit 5, Mockito, AssertJ, MockMvc, JSONPath: replaces the plain junit-jupiter dependency -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Only used by:  mvn compile exec:java   (runs the crash-recovery demo; not part of the build) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.sanjeev.sim.CrashRecoveryDemo</mainClass>
                </configuration>
            </plugin>
            <!--
              Runs the REST API:  mvn spring-boot:run   (or, after mvn package:  java -jar target/matching-engine-*.jar).
              "repackage" turns the plain jar into one executable jar that contains Tomcat and every dependency.
              Its version is not managed by the bill of materials, so it is set here.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.sanjeev.api.MatchingEngineApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Benchmarks (JMH). Everything JMH-related lives in this profile and in src/jmh/java, so the
          normal build, the tests and the engine never see it. Run them with:

            mvn -Pjmh compile exec:exec@jmh
            mvn -Pjmh compile exec:exec@jmh "-Djmh.args=Throughput -prof gc"

          exec:exec starts a plain `java -cp ...` process (not exec:java), because JMH forks fresh
          JVMs for each run and they need a real classpath to inherit.
        -->
        <profile>
            <id>jmh</id>
            <properties>
                <jmh.version>1.37</jmh.version>
                <jmh.args>.*Benchmark</jmh.args>
                <!-- only for exploring book depth with the sanity run; the benchmarks use the fixed default -->
                <bench.passive>80</bench.passive>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.openjdk.jmh</groupId>
                    <artifactId>jmh-core</artifactId>
                    <version>${jmh.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!-- compile src/jmh/java together with the main sources, in this profile only -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>add-jmh-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/jmh/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- the JMH annotation processor generates the benchmark harness classes -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.13.0</version>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jmh</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <commandlineArgs>-cp %classpath org.openjdk.jmh.Main ${jmh.args}</commandlineArgs>
                                </configuration>
                            </execution>
                            <!-- not a benchmark: runs the workload under Java Flight Recorder to show
                                 WHERE time and allocations go (mvn -Pjmh compile exec:exec@profile) -->
                            <execution>
                                <id>profile</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <commandlineArgs>-Xms1g -Xmx1g -XX:StartFlightRecording=filename=benchmarks/results/profile.jfr,settings=profile,dumponexit=true -cp %classpath com.sanjeev.bench.ProfileRun</commandlineArgs>
                                </configuration>
                            </execution>
                            <!-- not a benchmark: prints what the workload actually does
                                 (mvn -Pjmh compile exec:exec@sanity) -->
                            <execution>
                                <id>sanity</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>java</executable>
                                    <commandlineArgs>-Dbench.passive=${bench.passive} -cp %classpath com.sanjeev.bench.WorkloadSanity</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
